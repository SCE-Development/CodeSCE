# Frontend
FROM node:20-alpine

WORKDIR /app

COPY frontend/package.json .

RUN npm cache clean --force
RUN npm install

COPY frontend/ .

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "7777"]
# Backend Dev Dockerfile (Go/Gin)

FROM golang:1.25-alpine

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 6767

CMD ["go", "run", "./cmd/server"]
# Note: app should listen on port 6767
